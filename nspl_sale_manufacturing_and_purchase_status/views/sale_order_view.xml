<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_buttons" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.view.mrp.purchase</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_manufacturing_order"
                        type="object"
                        string="View Manufacturing Order"
                        class="btn-primary"
                        modifiers='{"invisible": [["state", "!=", "sale"]]}'/>

                <button name="action_view_purchase_order"
                        type="object"
                        string="View Purchase Order"
                        class="btn-secondary"
                        modifiers='{"invisible": [["state", "!=", "sale"]]}'/>
            </xpath>

        </field>
    </record>

</odoo>


